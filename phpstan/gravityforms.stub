<?php

// The parts of Gravity Forms that Gaffer calls (for phpstan only).

class GF_Field
{
    /** @var int */
    public $id;
    /** @var string */
    public $type;
    /** @var string */
    public $label;
    /** @var string */
    public $adminLabel;
    /** @var bool */
    public $isRequired;
    /** @var list<array{id: string, label?: string}>|null */
    public $inputs;
    /** @var list<array{text: string, value: string}>|null */
    public $choices;
    /** @var bool (fileupload) */
    public $multipleFiles;
    /** @var int|string (fileupload: 0 or '' = no limit) */
    public $maxFiles;
    /** @var string (fileupload: "jpg, png", '' = any allowed) */
    public $allowedExtensions;
    /** @var int|string (fileupload: MB, 0 or '' = the server's limit) */
    public $maxFileSize;
}

class GFFormsModel
{
    /** @var array<int, array<string, mixed>> the files kept per form, by input name */
    public static $uploaded_files;
}

class GFAPI
{
    /** @return list<array<string, mixed>> */
    public static function get_forms(bool $active = true, bool $trash = false): array {}

    /**
     * @param array<string, mixed> $input_values
     * @param array<string, mixed> $field_values
     * @return array<string, mixed>|\WP_Error
     */
    public static function submit_form(int $form_id, array $input_values, array $field_values = [], int $target_page = 0, int $source_page = 1): array|\WP_Error {}

    /**
     * @param array<string, mixed> $form_meta
     * @return int|\WP_Error
     */
    public static function add_form(array $form_meta): int|\WP_Error {}

    /**
     * @param array<string, mixed> $search_criteria
     * @return list<array<string, mixed>>|\WP_Error
     */
    public static function get_entries(int $form_ids, array $search_criteria = []): array|\WP_Error {}

    /** @return bool|\WP_Error */
    public static function delete_entry(int $entry_id): bool|\WP_Error {}

    /** @return bool|\WP_Error */
    public static function delete_form(int $form_id): bool|\WP_Error {}
}
