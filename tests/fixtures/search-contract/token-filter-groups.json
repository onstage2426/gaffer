{
    "call": "token",
    "args": [
        "products",
        {
            "limit": 10,
            "attributes": [
                "id"
            ],
            "filter": {
                "category": {
                    "all": [
                        "kleding",
                        "jurken"
                    ]
                },
                "any": [
                    {
                        "brand": "stella"
                    },
                    {
                        "color": "wit"
