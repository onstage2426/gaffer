{
    "name": "onstage2426/gaffer",
    "description": "WordPress theme framework — Twig and Vite",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "twig/twig": "^3.0",
        "twig/string-extra": "^3.0"
    },
    "require-dev": {
        "symfony/var-dumper": "^8.0",
        "rector/rector": "^2.5",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Gaffer\\": "src/"
        }
    },
    "scripts": {
        "rector": "rector process",
        "rector:dry": "rector process --dry-run",
        "phpstan": "phpstan analyse --memory-limit=512M"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
